# ---- LLM ------------------------------------------------------------------
# anthropic (default) or openai_compatible (OpenAI, Groq, OpenRouter, Together, Ollama ...)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (reasoning depth vs. cost)
LLM_EFFORT=high
ANTHROPIC_API_KEY=
# For LLM_PROVIDER=openai_compatible:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# Extra keys tried in order when one runs out: key or key|model or key|model|base_url, comma-separated
# OPENAI_API_KEYS=

# Fallback providers, used in order when the key above runs out (LLM_PROVIDER=openai_compatible)
# OPENAI_OFFICIAL_API_KEY=        (key from platform.openai.com)
# OPENAI_OFFICIAL_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ---- Web search (optional but recommended) --------------------------------
# tavily | brave | serper | none
SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---- Sandbox ---------------------------------------------------------------
# auto picks docker > seatbelt (macOS) > judge0 > none. Generated code never runs unsandboxed.
SANDBOX_BACKEND=auto
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=

# ---- Server ----------------------------------------------------------------
PORT=8765
